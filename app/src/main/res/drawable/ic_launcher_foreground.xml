<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher mark: a 4x4 module block, every module a whole square, with the two
  modules on the diagonal in the accent colour.

  Geometry: 4 modules of 8 units at a 10 unit pitch, spanning 38 units and
  centred in the 108 unit viewport. That puts the mark's bounding circle at
  ~27 units, comfortably inside the 66 unit safe zone, so nothing is clipped
  by a circular launcher mask.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Modules. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M45,35h8v8h-8z M55,35h8v8h-8z M65,35h8v8h-8z
                          M35,45h8v8h-8z M65,45h8v8h-8z
                          M35,55h8v8h-8z M45,55h8v8h-8z M65,55h8v8h-8z
                          M35,65h8v8h-8z M55,65h8v8h-8z" />

    <!-- The diagonal, in the accent colour. -->
    <path
        android:fillColor="#3D8FD1"
        android:pathData="M35,35h8v8h-8z M55,55h8v8h-8z" />

</vector>
